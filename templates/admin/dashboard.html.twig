{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard - Freiwilligen-Helfer{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="fw-bold mb-4"><i class="bi bi-speedometer2"></i> Admin Dashboard</h1>

    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-primary text-white">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50">Einsaetze</h6>
                            <h2 class="fw-bold mb-0">{{ events|length }}</h2>
                        </div>
                        <i class="bi bi-calendar-event fs-1 text-white-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-success text-white">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50">Registrierte Benutzer</h6>
                            <h2 class="fw-bold mb-0">{{ totalUsers }}</h2>
                        </div>
                        <i class="bi bi-people fs-1 text-white-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-info text-white">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50">Gesamtanmeldungen</h6>
                            <h2 class="fw-bold mb-0">
                                {% set totalRegs = 0 %}
                                {% for event in events %}
                                    {% set totalRegs = totalRegs + event.registrationCount %}
                                {% endfor %}
                                {{ totalRegs }}
                            </h2>
                        </div>
                        <i class="bi bi-clipboard-check fs-1 text-white-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3><i class="bi bi-list-ul"></i> Einsaetze Uebersicht</h3>
        <a href="{{ path('admin_event_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Neuer Einsatz
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Titel</th>
                        <th>Datum</th>
                        <th>Ort</th>
                        <th>Teilnehmer</th>
                        <th>Status</th>
                        <th>Aktionen</th>
                    </tr>
                </thead>
                <tbody>
                    {% for event in events %}
                    <tr>
                        <td class="fw-bold">{{ event.title }}</td>
                        <td>{{ event.date|date('d.m.Y, H:i') }}</td>
                        <td>{{ event.location }}</td>
                        <td>{{ event.registrationCount }} / {{ event.maxParticipants }}</td>
                        <td>
                            {% if event.isFullyBooked %}
                                <span class="badge bg-danger">Ausgebucht</span>
                            {% elseif event.date < date() %}
                                <span class="badge bg-secondary">Vergangen</span>
                            {% else %}
                                <span class="badge bg-success">Offen</span>
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ path('admin_event_registrations', {id: event.id}) }}" class="btn btn-sm btn-outline-info" title="Anmeldungen">
                                <i class="bi bi-people"></i>
                            </a>
                            <a href="{{ path('admin_event_edit', {id: event.id}) }}" class="btn btn-sm btn-outline-warning" title="Bearbeiten">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-4">
        <a href="{{ path('admin_events') }}" class="btn btn-outline-primary me-2">
            <i class="bi bi-calendar-event"></i> Alle Einsaetze verwalten
        </a>
        <a href="{{ path('admin_users') }}" class="btn btn-outline-secondary">
            <i class="bi bi-people"></i> Benutzer anzeigen
        </a>
    </div>
</div>
{% endblock %}
