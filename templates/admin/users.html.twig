{% extends 'base.html.twig' %}

{% block title %}Benutzer - Admin{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="fw-bold mb-4"><i class="bi bi-people"></i> Registrierte Benutzer</h1>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>E-Mail</th>
                        <th>Telefon</th>
                        <th>Rolle</th>
                        <th>Registriert am</th>
                        <th>Anmeldungen</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                    <tr>
                        <td>{{ user.id }}</td>
                        <td class="fw-bold">{{ user.fullName }}</td>
                        <td><a href="mailto:{{ user.email }}">{{ user.email }}</a></td>
                        <td>{{ user.phone ?? '-' }}</td>
                        <td>
                            {% if 'ROLE_ADMIN' in user.roles %}
                                <span class="badge bg-danger">Admin</span>
                            {% else %}
                                <span class="badge bg-primary">Benutzer</span>
                            {% endif %}
                        </td>
                        <td>{{ user.createdAt|date('d.m.Y, H:i') }}</td>
                        <td>{{ user.registrations|length }}</td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">Keine Benutzer vorhanden.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <a href="{{ path('admin_dashboard') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Zurueck zum Dashboard
        </a>
    </div>
</div>
{% endblock %}
