{% extends 'base.html.twig' %}

{% block title %}Einsaetze verwalten - Admin{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold"><i class="bi bi-calendar-event"></i> Einsaetze verwalten</h1>
        <a href="{{ path('admin_event_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Neuer Einsatz
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Titel</th>
                        <th>Datum</th>
                        <th>Ort</th>
                        <th>Teilnehmer</th>
                        <th>Erstellt von</th>
                        <th>Aktionen</th>
                    </tr>
                </thead>
                <tbody>
                    {% for event in events %}
                    <tr>
                        <td>{{ event.id }}</td>
                        <td class="fw-bold">
                            <a href="{{ path('app_event_show', {id: event.id}) }}">{{ event.title }}</a>
                        </td>
                        <td>{{ event.date|date('d.m.Y, H:i') }}</td>
                        <td>{{ event.location }}</td>
                        <td>
                            <span class="{% if event.isFullyBooked %}text-danger{% else %}text-success{% endif %}">
                                {{ event.registrationCount }} / {{ event.maxParticipants }}
                            </span>
                        </td>
                        <td>{{ event.createdBy.fullName }}</td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <a href="{{ path('admin_event_registrations', {id: event.id}) }}" class="btn btn-outline-info" title="Anmeldungen anzeigen">
                                    <i class="bi bi-people"></i>
                                </a>
                                <a href="{{ path('admin_event_edit', {id: event.id}) }}" class="btn btn-outline-warning" title="Bearbeiten">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" action="{{ path('admin_event_delete', {id: event.id}) }}" class="d-inline" onsubmit="return confirm('Moechten Sie diesen Einsatz wirklich loeschen?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ event.id) }}">
                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Loeschen">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">Keine Einsaetze vorhanden.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <a href="{{ path('admin_dashboard') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Zurueck zum Dashboard
        </a>
    </div>
</div>
{% endblock %}
