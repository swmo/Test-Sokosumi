{% extends 'base.html.twig' %}

{% block title %}Anmelden - Freiwilligen-Helfer{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h2 class="text-center fw-bold mb-4">
                        <i class="bi bi-box-arrow-in-right text-primary"></i> Anmelden
                    </h2>

                    {% if error %}
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle"></i> Ungueltige Anmeldedaten. Bitte versuchen Sie es erneut.
                        </div>
                    {% endif %}

                    <form method="post" action="{{ path('app_login') }}">
                        <div class="mb-3">
                            <label for="inputEmail" class="form-label">E-Mail-Adresse</label>
                            <input type="email" id="inputEmail" name="_username" class="form-control" value="{{ last_username }}" required autofocus placeholder="E-Mail-Adresse">
                        </div>
                        <div class="mb-3">
                            <label for="inputPassword" class="form-label">Passwort</label>
                            <input type="password" id="inputPassword" name="_password" class="form-control" required placeholder="Passwort">
                        </div>

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        <button type="submit" class="btn btn-primary w-100 btn-lg mt-2">
                            <i class="bi bi-box-arrow-in-right"></i> Anmelden
                        </button>
                    </form>

                    <hr class="my-4">
                    <p class="text-center text-muted mb-0">
                        Noch kein Konto? <a href="{{ path('app_register') }}">Jetzt registrieren</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
